<section class="apotheosis-sheet">
	<h1>{{actor.name}}</h1>

	<div class="attributes">
		{{#each attributes as |attribute|}}
			<div class="attribute">
				<label>{{localize attribute.label}}</label>
				<input type="number" name="system.attributes.{{attribute.key}}.value" value="{{attribute.value}}">
				/
				<input type="number" name="system.attributes.{{attribute.key}}.max" value="{{attribute.max}}">
			</div>
			{{#each attribute.actions as |action|}}
				<label>{{localize action.label}}</label>
				<input type="number" name="system.actions.{{action.key}}" value="{{action.value}}">
			{{/each}}
		{{/each}}
	</div>
	<div class="energy">
		<h2>{{localize "APOTHEOSIS.Energy.Label"}}</h2>

		<label>
			{{localize "APOTHEOSIS.Energy.Current"}}
			<input type="number" name="system.energy.value" value="{{system.energy.value}}">
		</label>

		<label>
			{{localize "APOTHEOSIS.Energy.Capacity"}}
			<input type="number" name="system.energy.max" value="{{system.energy.max}}">
		</label>

		<label>
			{{localize "APOTHEOSIS.Energy.Efficiency"}}
			<input type="number" name="system.energy.efficiency" value="{{system.energy.efficiency}}">
		</label>

		<span class="multiplier">x{{system.energy.multiplier}}</span>

		<label>
			{{localize "APOTHEOSIS.Energy.Mastery"}}
			<select name="system.energy.mastery">
				{{selectOptions masteryLevels selected=system.energy.mastery localize=true}}
			</select>
		</label>
	</div>

</section>
